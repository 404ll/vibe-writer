# TypeScript Worker (deploy this as a persistent process, not a Vercel Function)
DURABLE_WORKER_ENABLED=true
DURABLE_WORKER_ROLE=all
WORKER_ID=vibe-writer-worker-1
CODE_REVISION=git_commit_sha_here
WORKER_CONCURRENCY=1
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=8790

# PostgreSQL runtime roles provisioned by packages/db
DATABASE_WRITE_DISPATCHER_URL=postgresql://dispatcher:change_me@db.example.com:5432/vibe_writer?sslmode=require
WRITE_DISPATCHER_DATABASE_ROLE=vibe_writer_write_dispatcher
DATABASE_WRITE_CONSUMER_URL=postgresql://consumer:change_me@db.example.com:5432/vibe_writer?sslmode=require
WRITE_CONSUMER_DATABASE_ROLE=vibe_writer_write_consumer

# BullMQ-compatible Redis is used only by the persistent Worker. For the
# single-server MVP it stays loopback-only and is never exposed to Vercel.
REDIS_URL=redis://127.0.0.1:6379

# Model and search providers used only by the Worker
ANTHROPIC_API_KEY=your_api_key_here
MODEL_ID=your_model_id_here
# TAVILY_API_KEY=your_tavily_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
