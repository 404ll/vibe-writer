{
  "name": "@vibe-writer/eval-cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "node --import tsx src/cli.ts check",
    "report": "node --import tsx src/cli.ts report",
    "baseline": "node --import tsx src/cli.ts baseline",
    "register": "node --import tsx src/cli.ts register",
    "enqueue": "node --import tsx src/cli.ts enqueue",
    "enqueue:live": "node --import tsx src/cli.ts enqueue-live",
    "start:queue": "tsx src/queue-main.ts",
    "start:live-sampler": "tsx src/live-sampler-main.ts",
    "memory:check": "node --import tsx src/memory-governance-cli.ts check",
    "memory:report": "node --import tsx src/memory-governance-cli.ts report",
    "memory:baseline": "node --import tsx src/memory-governance-cli.ts baseline",
    "memory-extraction:check": "node --import tsx src/memory-extraction-cli.ts check",
    "memory-extraction:report": "node --import tsx src/memory-extraction-cli.ts report",
    "memory-extraction:baseline": "node --import tsx src/memory-extraction-cli.ts baseline",
    "memory-calibration:check": "node --import tsx src/memory-calibration-cli.ts",
    "memory-calibration:preflight": "node --import tsx src/memory-calibration-preflight-cli.ts",
    "memory-calibration:authorize": "node --import tsx src/memory-calibration-authorization-cli.ts",
    "test": "vitest run tests/component-suite.test.ts tests/memory-governance-suite.test.ts tests/memory-extraction-suite.test.ts tests/memory-calibration-readiness.test.ts tests/memory-calibration-execution.test.ts tests/architecture.test.ts tests/queue.test.ts tests/live-sampler.test.ts tests/live-article-grader.test.ts tests/ci-artifact.test.ts",
    "ci:artifact": "node --import tsx src/ci-artifact-cli.ts",
    "test:redis": "vitest run tests/queue.redis.integration.test.ts",
    "test:runtime-roles": "vitest run tests/queue.postgres-redis.integration.test.ts",
    "test:live-sampler:postgres": "vitest run tests/live-sampler.postgres.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.0.0",
    "@vibe-writer/agent-core": "workspace:*",
    "@vibe-writer/contracts": "workspace:*",
    "@vibe-writer/db": "workspace:*",
    "@vibe-writer/eval-core": "workspace:*",
    "@vibe-writer/eval-graders": "workspace:*",
    "@vibe-writer/memory-core": "workspace:*",
    "@vibe-writer/model-runtime": "workspace:*",
    "@vibe-writer/provider-runtime": "workspace:*",
    "@vibe-writer/workflow-runtime": "workspace:*",
    "bullmq": "5.81.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.12.2",
    "drizzle-orm": "^0.45.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
