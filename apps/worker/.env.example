DURABLE_WORKER_ENABLED=false
DURABLE_WORKER_ROLE=all
WORKER_ID=writer-worker-local-1
CODE_REVISION=local-dev

# Runtime identities are separate even when DURABLE_WORKER_ROLE=all.
DATABASE_WRITE_DISPATCHER_URL=postgresql://vibe_writer_write_dispatcher:change_me@127.0.0.1:5432/vibe_writer
WRITE_DISPATCHER_DATABASE_ROLE=vibe_writer_write_dispatcher
DATABASE_WRITE_CONSUMER_URL=postgresql://vibe_writer_write_consumer:change_me@127.0.0.1:5432/vibe_writer
WRITE_CONSUMER_DATABASE_ROLE=vibe_writer_write_consumer
# Self-hosted PostgreSQL defaults to cross-workspace BYPASSRLS. Managed
# PostgreSQL can instead use single-workspace plus a connection-level
# `options=-c app.workspace_id=<UUID>` parameter in the consumer URL.
WRITE_CONSUMER_ACCESS_MODE=cross-workspace
# WORKER_SINGLE_USER_WORKSPACE_ID=00000000-0000-4000-8000-000000000002
REDIS_URL=redis://127.0.0.1:6379/0

# Deployment/admin commands only; do not expose these URLs to the Worker runtime.
# DATABASE_ADMIN_URL=postgresql://vibe_writer_migration:change_me@127.0.0.1:5432/vibe_writer
# DATABASE_CHECKPOINT_ADMIN_URL=postgresql://vibe_writer_migration:change_me@127.0.0.1:5432/vibe_writer

# Optional HTTP probe server: GET /live and GET /ready.
# WORKER_HEALTH_HOST=0.0.0.0
# WORKER_HEALTH_PORT=3001

ANTHROPIC_API_KEY=your_api_key_here
MODEL_ID=your_model_id_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional. Without it, Writer runs without the search tool.
# TAVILY_API_KEY=your_tavily_api_key_here
# TAVILY_BASE_URL=https://api.tavily.com

# WRITE_QUEUE_NAME=vibe-writer-write
# BULLMQ_PREFIX=vibe-writer
# WORKER_CONCURRENCY=2
# WORKER_LEASE_DURATION_MS=60000
# WORKER_HEARTBEAT_INTERVAL_MS=15000
# BULLMQ_LOCK_DURATION_MS=120000
# OUTBOX_POLL_MS=500
# OUTBOX_BATCH_SIZE=50

# Independent DB-only Memory retention maintenance process. Disabled by default.
MEMORY_RETENTION_MAINTENANCE_ENABLED=false
DATABASE_MEMORY_RETENTION_URL=postgresql://vibe_writer_memory_retention:change_me@127.0.0.1:5432/vibe_writer
MEMORY_RETENTION_DATABASE_ROLE=vibe_writer_memory_retention
MEMORY_RETENTION_WORKER_ID=memory-retention-local-1
# MEMORY_RETENTION_BATCH_SIZE=100
# MEMORY_RETENTION_POLL_MS=60000
# MEMORY_RETENTION_BACKLOG_POLL_MS=250
# MEMORY_RETENTION_BACKLOG_ALERT_THRESHOLD=1000
# MEMORY_RETENTION_HEALTH_HOST=0.0.0.0
# MEMORY_RETENTION_HEALTH_PORT=3002
