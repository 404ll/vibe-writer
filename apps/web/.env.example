# Migration default: keep browser and Server Component reads on FastAPI/Python.
NEXT_PUBLIC_API_BASE=/api
API_PROXY_TARGET=http://127.0.0.1:8000

# Staging durable routes stay fail-closed until explicitly enabled.
DURABLE_API_ENABLED=false
DURABLE_ARTICLE_READ_ENABLED=false
# Archived Memory experiment; not part of the current product MVP.
DURABLE_MEMORY_SIGNAL_API_ENABLED=false
DURABLE_MEMORY_MANAGEMENT_API_ENABLED=false
# Must select an exact version in the append-only server policy registry.
MEMORY_CONSENT_POLICY_VERSION=memory-consent-v1
DATABASE_URL=postgresql://vibe_writer:change_me@127.0.0.1:5432/vibe_writer
# Public durable traffic should use a non-owner, no-BYPASSRLS API role here.
# DATABASE_API_URL=postgresql://vibe_writer_api:change_me@127.0.0.1:5432/vibe_writer

# Only enable this when a trusted reverse proxy strips client-supplied values
# and injects both x-vibe-principal-id and x-vibe-workspace-id.
DURABLE_AUTH_MODE=disabled

# Local single-user durable development only. `pnpm dev:durable` supplies these
# automatically and the mode fails closed outside `next dev`.
# DURABLE_AUTH_MODE=local-development
# DURABLE_LOCAL_PRINCIPAL_ID=00000000-0000-4000-8000-000000000001
# DURABLE_LOCAL_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# Cutover build/runtime pair (do not change only one side):
# NEXT_PUBLIC_API_BASE=/api/durable
# DURABLE_API_ENABLED=true
# DURABLE_ARTICLE_READ_ENABLED=true
# DURABLE_AUTH_MODE=trusted-proxy
