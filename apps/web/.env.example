# Vercel Preview: the browser and Server Components use the only TypeScript API.
NEXT_PUBLIC_API_BASE=/api/durable
DURABLE_API_ENABLED=true

# Use the dedicated non-owner API role provisioned by packages/db.
DATABASE_API_URL=postgresql://vibe_writer_api:change_me@db.example.com:5432/vibe_writer?sslmode=require

# Personal MVP identity. This mode fails closed outside a Vercel Preview and
# requires Vercel Authentication to be enabled for the deployment.
DURABLE_AUTH_MODE=protected-single-user
DURABLE_EXTERNAL_ACCESS_PROTECTION=true
DURABLE_SINGLE_USER_PRINCIPAL_ID=00000000-0000-4000-8000-000000000001
DURABLE_SINGLE_USER_WORKSPACE_ID=00000000-0000-4000-8000-000000000002

# Archived Memory experiment; not part of the current product MVP.
DURABLE_MEMORY_SIGNAL_API_ENABLED=false
DURABLE_MEMORY_MANAGEMENT_API_ENABLED=false
MEMORY_CONSENT_POLICY_VERSION=memory-consent-v1
