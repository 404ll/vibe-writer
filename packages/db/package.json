{
  "name": "@vibe-writer/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./durable-api-role": "./src/durable-api-role.ts",
    "./memory-retention-role": "./src/memory-retention-role.ts",
    "./postgres-role-contract": "./src/postgres-role-contract.ts",
    "./migrations": "./src/migrations.ts",
    "./domain": "./src/domain.ts",
    "./repositories/jobs": "./src/repositories/jobs.ts",
    "./repositories/outbox": "./src/repositories/outbox.ts",
    "./repositories/terminals": "./src/repositories/terminals.ts",
    "./repositories/commands": "./src/repositories/commands.ts",
    "./repositories/articles": "./src/repositories/articles.ts",
    "./repositories/traces": "./src/repositories/traces.ts",
    "./repositories/evals": "./src/repositories/evals.ts",
    "./repositories/eval-candidates": "./src/repositories/eval-candidates.ts",
    "./repositories/eval-sampling": "./src/repositories/eval-sampling.ts",
    "./repositories/eval-materialization": "./src/repositories/eval-materialization.ts",
    "./repositories/memory-calibrations": "./src/repositories/memory-calibrations.ts",
    "./repositories/memories": "./src/repositories/memories.ts",
    "./repositories/memory-extractions": "./src/repositories/memory-extractions.ts",
    "./repositories/memory-reconciliations": "./src/repositories/memory-reconciliations.ts",
    "./repositories/memory-source-signals": "./src/repositories/memory-source-signals.ts",
    "./repositories/workspaces": "./src/repositories/workspaces.ts",
    "./repositories/scoped": "./src/repositories/scoped.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "check:migrations": "drizzle-kit check",
    "durable-api-role:provision": "tsx src/durable-api-role-cli.ts provision",
    "durable-api-role:verify": "tsx src/durable-api-role-cli.ts verify",
    "memory-retention-role:provision": "tsx src/memory-retention-role-cli.ts provision",
    "memory-retention-role:verify": "tsx src/memory-retention-role-cli.ts verify",
    "write-dispatcher-role:provision": "tsx src/write-runtime-role-cli.ts dispatcher provision",
    "write-dispatcher-role:verify": "tsx src/write-runtime-role-cli.ts dispatcher verify",
    "write-consumer-role:provision": "tsx src/write-runtime-role-cli.ts consumer provision",
    "write-consumer-role:verify": "tsx src/write-runtime-role-cli.ts consumer verify",
    "durable-dev:prepare": "tsx src/durable-dev-database-cli.ts prepare",
    "durable-dev:provision": "tsx src/durable-dev-database-cli.ts provision",
    "eval-dispatcher-role:provision": "tsx src/eval-runtime-role-cli.ts dispatcher provision",
    "eval-dispatcher-role:verify": "tsx src/eval-runtime-role-cli.ts dispatcher verify",
    "eval-consumer-role:provision": "tsx src/eval-runtime-role-cli.ts consumer provision",
    "eval-consumer-role:verify": "tsx src/eval-runtime-role-cli.ts consumer verify",
    "eval-live-sampler-role:provision": "tsx src/eval-runtime-role-cli.ts live-sampler provision",
    "eval-live-sampler-role:verify": "tsx src/eval-runtime-role-cli.ts live-sampler verify",
    "test": "vitest run --maxWorkers=4 tests/jobs.integration.test.ts tests/checkpoints.integration.test.ts tests/outbox.integration.test.ts tests/terminals.integration.test.ts tests/commands.integration.test.ts tests/articles.integration.test.ts tests/trace-eval.integration.test.ts tests/eval-candidates.integration.test.ts tests/eval-sampling.integration.test.ts tests/eval-materialization.integration.test.ts tests/memory-calibrations.integration.test.ts tests/memories.integration.test.ts tests/memory-extractions.integration.test.ts tests/memory-reconciliations.integration.test.ts tests/memory-source-signals.integration.test.ts tests/workspaces.integration.test.ts tests/durable-api-role.test.ts tests/memory-retention-role.test.ts tests/write-runtime-roles.test.ts tests/eval-runtime-roles.test.ts tests/architecture.test.ts",
    "test:postgres": "vitest run tests/postgres.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vibe-writer/contracts": "workspace:*",
    "@vibe-writer/eval-core": "workspace:*",
    "@vibe-writer/memory-core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.12.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.9"
  }
}
