    "test:durable-product:local": "node scripts/run-durable-product-smoke.mjs",
    "dev:web": "pnpm --filter @vibe-writer/web dev",
    "build:web": "pnpm --filter @vibe-writer/web build",
    "lint:web": "pnpm --filter @vibe-writer/web lint",
    "test:web": "pnpm --filter @vibe-writer/web test",
    "test:contracts": "pnpm --filter @vibe-writer/contracts test",
    "typecheck:contracts": "pnpm --filter @vibe-writer/contracts typecheck",
    "test:model-runtime": "pnpm --filter @vibe-writer/model-runtime test",
    "typecheck:model-runtime": "pnpm --filter @vibe-writer/model-runtime typecheck",
    "test:provider-runtime": "pnpm --filter @vibe-writer/provider-runtime test",
    "typecheck:provider-runtime": "pnpm --filter @vibe-writer/provider-runtime typecheck",
    "test:eval-core": "pnpm --filter @vibe-writer/eval-core test",
    "typecheck:eval-core": "pnpm --filter @vibe-writer/eval-core typecheck",
    "test:eval-graders": "pnpm --filter @vibe-writer/eval-graders test",
    "typecheck:eval-graders": "pnpm --filter @vibe-writer/eval-graders typecheck",
    "test:memory-core": "pnpm --filter @vibe-writer/memory-core test",
    "typecheck:memory-core": "pnpm --filter @vibe-writer/memory-core typecheck",
    "test:eval-cli": "pnpm --filter @vibe-writer/eval-cli test",
    "test:eval-queue:local": "node scripts/run-eval-queue-integration.mjs",
    "typecheck:eval-cli": "pnpm --filter @vibe-writer/eval-cli typecheck",
    "eval:components": "pnpm --filter @vibe-writer/eval-cli check",
    "eval:components:report": "pnpm --filter @vibe-writer/eval-cli report",
    "eval:components:baseline": "pnpm --filter @vibe-writer/eval-cli baseline",
    "eval:components:register": "pnpm --filter @vibe-writer/eval-cli register",
    "eval:components:enqueue": "pnpm --filter @vibe-writer/eval-cli enqueue",
    "eval:live:enqueue": "pnpm --filter @vibe-writer/eval-cli enqueue:live",
    "start:eval-worker": "pnpm --filter @vibe-writer/eval-cli start:queue",
    "start:eval-live-sampler": "pnpm --filter @vibe-writer/eval-cli start:live-sampler",
    "eval:workflow-shadow": "pnpm --filter @vibe-writer/eval-cli workflow:check",
    "eval:workflow-shadow:report": "pnpm --filter @vibe-writer/eval-cli workflow:report",
    "eval:workflow-shadow:baseline": "pnpm --filter @vibe-writer/eval-cli workflow:baseline",
    "eval:memory": "pnpm --filter @vibe-writer/eval-cli memory:check",
    "eval:memory:report": "pnpm --filter @vibe-writer/eval-cli memory:report",
    "eval:memory:baseline": "pnpm --filter @vibe-writer/eval-cli memory:baseline",
    "eval:memory-extraction": "pnpm --filter @vibe-writer/eval-cli memory-extraction:check",
    "eval:memory-extraction:report": "pnpm --filter @vibe-writer/eval-cli memory-extraction:report",
    "eval:memory-extraction:baseline": "pnpm --filter @vibe-writer/eval-cli memory-extraction:baseline",
    "eval:memory-calibration": "pnpm --filter @vibe-writer/eval-cli memory-calibration:check",
    "eval:memory-calibration:preflight": "pnpm --filter @vibe-writer/eval-cli memory-calibration:preflight",
    "eval:memory-calibration:authorize": "pnpm --filter @vibe-writer/eval-cli memory-calibration:authorize",
    "eval:ci:artifact": "pnpm --filter @vibe-writer/eval-cli ci:artifact",
    "eval:production-composition:local": "pnpm test:worker:production:local",
    "test:agent-core": "pnpm --filter @vibe-writer/agent-core test",
    "typecheck:agent-core": "pnpm --filter @vibe-writer/agent-core typecheck",
    "test:workflow-runtime": "pnpm --filter @vibe-writer/workflow-runtime test",
    "typecheck:workflow-runtime": "pnpm --filter @vibe-writer/workflow-runtime typecheck",
    "test:checkpoint-runtime": "pnpm --filter @vibe-writer/checkpoint-runtime test",
    "typecheck:checkpoint-runtime": "pnpm --filter @vibe-writer/checkpoint-runtime typecheck",
    "setup:checkpoint-schema": "pnpm --filter @vibe-writer/checkpoint-runtime schema:setup",
    "test:worker": "pnpm --filter @vibe-writer/worker test",
    "start:worker": "pnpm --filter @vibe-writer/worker start",
    "start:memory-retention": "pnpm --filter @vibe-writer/worker start:memory-retention",
    "migrate:articles:sqlite": "pnpm --filter @vibe-writer/worker migrate:articles:sqlite",
    "test:worker:redis:local": "node scripts/run-redis-integration.mjs",
    "test:worker:production:local": "node scripts/run-production-integration.mjs",
    "test:memory-api-canary:local": "node scripts/run-memory-api-canary.mjs",
    "test:memory-retention-role:local": "node scripts/run-memory-retention-role-canary.mjs",
    "typecheck:worker": "pnpm --filter @vibe-writer/worker typecheck",
    "check:docs": "node scripts/check-markdown-links.mjs",
    "test:db": "pnpm --filter @vibe-writer/db test",
    "test:db:postgres": "pnpm --filter @vibe-writer/db test:postgres",
    "test:db:postgres:local": "node scripts/run-postgres-integration.mjs",
    "typecheck:db": "pnpm --filter @vibe-writer/db typecheck",
    "check:migrations": "pnpm --filter @vibe-writer/db check:migrations",
    "test:api": "cd apps/api && ${API_PYTHON:-../../.venv/bin/python} -m pytest",
    "verify": "pnpm test:contracts && pnpm typecheck:contracts && pnpm test:model-runtime && pnpm typecheck:model-runtime && pnpm test:provider-runtime && pnpm typecheck:provider-runtime && pnpm test:eval-core && pnpm typecheck:eval-core && pnpm test:eval-graders && pnpm typecheck:eval-graders && pnpm test:memory-core && pnpm typecheck:memory-core && pnpm test:eval-cli && pnpm typecheck:eval-cli && pnpm eval:components && pnpm eval:memory && pnpm eval:memory-extraction && pnpm eval:memory-calibration && pnpm eval:memory-calibration:preflight && pnpm test:agent-core && pnpm typecheck:agent-core && pnpm test:workflow-runtime && pnpm typecheck:workflow-runtime && pnpm test:db && pnpm typecheck:db && pnpm check:migrations && pnpm test:checkpoint-runtime && pnpm typecheck:checkpoint-runtime && pnpm test:worker && pnpm typecheck:worker && pnpm test:api && pnpm eval:workflow-shadow && pnpm lint:web && pnpm test:web && pnpm build:web && pnpm check:docs"
  }
}
